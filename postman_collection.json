{
  "info": {
    "name": "Spotter Fuel Route Optimizer",
    "description": "API for finding optimal fuel stops along a US driving route",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Route: New York to Los Angeles (cross-country)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/v1/route/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "route", ""]
        }
      }
    },
